{
  "name": "@storycap-testrun/internal",
  "version": "2.1.0",
  "description": "Core utilities and shared types for storycap-testrun - Provides screenshot options, stability checks, hook processing, and common functionality for browser and Node.js environments",
  "keywords": [
    "storybook",
    "storycap"
  ],
  "homepage": "https://github.com/reg-viz/storycap-testrun",
  "bugs": {
    "url": "https://github.com/reg-viz/storycap-testrun/issues"
  },
  "license": "MIT",
  "author": "wadackel",
  "contributors": [
    "Yosuke Kurami"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/reg-viz/storycap-testrun.git",
    "directory": "packages/internal"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "minify": true,
    "sourcemap": false,
    "splitting": false
  }
}
