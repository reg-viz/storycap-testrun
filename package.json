{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --if-present -r build",
    "canary:enter": "changeset pre enter canary",
    "canary:exit": "changeset pre exit",
    "changelog": "changeset add",
    "clean": "pnpm --if-present -r clean",
    "clean:all": "pnpm clean && pnpm clean:deps",
    "clean:deps": "rimraf -g \"node_modules\" \"**/node_modules\"",
    "format": "pnpm format:script && pnpm format:oxfmt",
    "format:oxfmt": "oxfmt --write .",
    "format:script": "oxlint --fix --type-aware --tsconfig=./tsconfig.base.json",
    "lint": "pnpm lint:oxfmt && pnpm lint:script",
    "lint:oxfmt": "oxfmt --check .",
    "lint:script": "oxlint --type-aware --tsconfig=./tsconfig.base.json",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "zx scripts/e2e.js",
    "test:unit": "vitest run",
    "typecheck": "pnpm --if-present -r typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@tsconfig/node22": "22.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "22.20.1",
    "@vitest/ui": "4.1.11",
    "happy-dom": "20.11.6",
    "lefthook": "2.1.10",
    "oxfmt": "0.64.0",
    "oxlint": "1.55.0",
    "oxlint-tsgolint": "0.21.1",
    "playwright": "1.62.1",
    "rimraf": "6.1.3",
    "tsdown": "0.21.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zx": "8.8.5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "playwright-core": "$playwright"
    }
  }
}
