{
  "extends": ["@tsconfig/strictest/tsconfig", "@tsconfig/node22/tsconfig"],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": true,
    "noEmit": true
  }
}
